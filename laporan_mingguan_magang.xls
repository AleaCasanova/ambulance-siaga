<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="TitleStyle">
   <Font ss:FontName="Calibri" ss:Size="14" ss:Bold="1" ss:Color="#000000"/>
   <Alignment ss:Vertical="Center"/>
  </Style>
  <Style ss:ID="SubtitleStyle">
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#1F497D"/>
   <Alignment ss:Vertical="Center"/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#2E75B6" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="CellNo">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10"/>
  </Style>
  <Style ss:ID="CellText">
   <Alignment ss:Horizontal="Left" ss:Vertical="Top" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10"/>
  </Style>
  <Style ss:ID="CellStatus">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#1E4620"/>
   <Interior ss:Color="#E2EFDA" ss:Pattern="Solid"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Minggu 1">
  <Table ss:DefaultRowHeight="20">
   <Column ss:Width="35"/>
   <Column ss:Width="200"/>
   <Column ss:Width="380"/>
   <Column ss:Width="240"/>
   <Column ss:Width="160"/>
   <Row ss:Height="25">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Form Detail Pekerjaan</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SubtitleStyle"><Data ss:Type="String">Minggu ke : 1 | Hari : Senin – Jumat | Tanggal : 3 Agustus – 7 Agustus | Tahun : 2026</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>
   <Row ss:Height="28">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Pekerjaan/Tugas</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Uraian Pekerjaan</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Gambar</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Keterangan</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Inisialisasi Lingkungan Proyek & Setup Basis Data Awal</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Melakukan inisialisasi framework Laravel 11, Livewire 3, Tailwind CSS, serta perancangan skema database dasar (users, roles, masyarakat, supir, ambulans, rumah_sakit).</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot struktur folder projek Laravel & daftar migrasi database</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Environment & Database siap)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Pembuatan Form Pemesanan Pasien & Integrasi Peta Awal</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Mengembangkan antarmuka pemesanan ambulans masyarakat (order-create), integrasi Leaflet.js untuk penentuan titik jemput pasien, dan migrasi pelengkap form pemesanan.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot formulir pemesanan ambulans dan picker peta Leaflet</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Form & pin lokasi berfungsi)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Implementasi Modul Autentikasi & Registrasi Multi-Role</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Membangun alur login dan registrasi multi-role (Masyarakat, Supir, Mitra), serta penambahan fitur upload foto verifikasi kondisi darurat pasien.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot halaman Login, Register, dan form pendaftaran armada</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Autentikasi multi-role aktif)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Pengembangan Sistem Verifikasi Email & OTP</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Mengintegrasikan sistem verifikasi akun berbasis OTP/Email (tabel otp_verifications), pembuatan template email kode OTP, dan perapian tampilan awal landing page.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot form verifikasi kode OTP dan preview email notifikasi</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Verifikasi OTP berfungsi)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Inisiasi Modul Donasi & Sinkronisasi Kode Tim (Git Merge)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Membangun antarmuka halaman donasi publik (donasi.blade.php), menyelesaikan resolusi konflik merge branch repository tim, dan pengujian alur order darurat tahap 1.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot halaman donasi ambulans siaga & histori git merge</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Modul donasi aktif & repo sinkron)</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
 <Worksheet ss:Name="Minggu 2">
  <Table ss:DefaultRowHeight="20">
   <Column ss:Width="35"/>
   <Column ss:Width="200"/>
   <Column ss:Width="380"/>
   <Column ss:Width="240"/>
   <Column ss:Width="160"/>
   <Row ss:Height="25">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Form Detail Pekerjaan</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SubtitleStyle"><Data ss:Type="String">Minggu ke : 2 | Hari : Senin – Jumat | Tanggal : 10 Agustus – 14 Agustus | Tahun : 2026</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>
   <Row ss:Height="28">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Pekerjaan/Tugas</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Uraian Pekerjaan</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Gambar</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Keterangan</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Refaktor Sistem Role & Peningkatan Komponen Navbar</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Melakukan refaktor hak akses pengguna menjadi 4 role utama (Admin, Operator, Supir, Masyarakat), memperbaiki lonceng notifikasi dan tata letak judul header aplikasi.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot navbar notifikasi & menu navigasi per role</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Sistem role terstruktur)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Desain Ulang Hero Section & Landing Page Beranda</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Mengembangkan tampilan visual modern pada halaman Beranda utama (Hero section interaktif, kartu keunggulan layanan darurat, dan layout responsif).</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot tampilan baru Landing Page Beranda</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Landing page responsif & modern)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Pengembangan Landing Page Portal Supir & Mitra Lembaga</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Menambahkan halaman landing page khusus informasi pendaftaran supir ambulans dan kemitraan lembaga, serta optimasi aset gambar ilustrasi.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot portal supir dan portal kemitraan lembaga</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Portal supir & mitra siap)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Perancangan Skema Database Donasi & Midtrans Gateway</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Membuat migrasi tabel donasis, konfigurasi environment API Midtrans (Client Key & Server Key), dan penyiapan webhook handler status transaksi donasi.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot skema tabel donasis dan form input donasi</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Database & konfigurasi API siap)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Integrasi Payment Gateway Midtrans & Manajemen Mitra</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Mengimplementasikan integrasi Midtrans Snap popup (QRIS, Bank Transfer, E-Wallet), migrasi tabel mitras, role Mitra lembaga, dan status alur 'menunggu_konfirmasi_supir'.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot popup pembayaran Midtrans Snap & dashboard mitra</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Transaksi donasi online berhasil)</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
 <Worksheet ss:Name="Minggu 3">
  <Table ss:DefaultRowHeight="20">
   <Column ss:Width="35"/>
   <Column ss:Width="200"/>
   <Column ss:Width="380"/>
   <Column ss:Width="240"/>
   <Column ss:Width="160"/>
   <Row ss:Height="25">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Form Detail Pekerjaan</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SubtitleStyle"><Data ss:Type="String">Minggu ke : 3 | Hari : Senin – Jumat | Tanggal : 17 Agustus – 21 Agustus | Tahun : 2026</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>
   <Row ss:Height="28">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Pekerjaan/Tugas</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Uraian Pekerjaan</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Gambar</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Keterangan</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Pengembangan Portal Supir & Bottom Navigation Mobile</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Membangun dashboard kerja khusus supir (tugas-index.blade.php) dan sistem bottom navigation bar untuk mempermudah operasional supir di smartphone mobile.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot dashboard supir & mobile bottom nav</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Mobile console supir aktif)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Penambahan Prioritas Pesanan & Berkas Kelayakan Supir</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Menambahkan fitur unggah berkas foto SIM & STNK pada verifikasi akun supir, kolom prioritas darurat (Gawat Darurat / Normal), serta pagination tabel pesanan.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot form upload SIM/STNK & badge prioritas order</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Verifikasi supir & triage darurat siap)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Integrasi API Token & Sistem Dispatching Operator</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Setup Laravel Sanctum untuk REST API token perangkat GPS dan penguatan konsol dispatch operator untuk penugasan armada ambulans terdekat.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot konsol dispatching operator & route API</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (API & dispatch console aktif)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Optimalisasi Real-time Tracking GPS & Rute OSRM</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Mengembangkan pelacakan posisi ambulans secara langsung (Livewire polling), kalkulasi rute OSRM dengan garis polyline, dan estimasi waktu sampai (ETA).</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot halaman tracking live ambulans & rute jalan</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Live tracking & kalkulasi ETA aktif)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Penyempurnaan Modul Ulasan (Rating) & Kwitansi Donasi</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Migrasi penyempurnaan tabel ratings untuk feedback masyarakat, halaman kwitansi bukti donasi sukses, dan perbaikan tampilan rincian pesanan.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot form rating bintang ulasan & kwitansi donasi</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Modul rating & kwitansi selesai)</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
