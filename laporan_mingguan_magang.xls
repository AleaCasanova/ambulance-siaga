  <Table ss:DefaultRowHeight="20">
   <Column ss:Width="35"/>
   <Column ss:Width="200"/>
   <Column ss:Width="380"/>
   <Column ss:Width="240"/>
   <Column ss:Width="160"/>
   <Row ss:Height="25">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Form Detail Pekerjaan</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SubtitleStyle"><Data ss:Type="String">Minggu ke : 4 | Hari : Senin – Jumat | Tanggal : 24 Agustus – 28 Agustus | Tahun : 2026</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>
   <Row ss:Height="28">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Pekerjaan/Tugas</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Uraian Pekerjaan</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Gambar</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Keterangan</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Penyeragaman & Optimalisasi Peta Leaflet Seluruh Role</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Menyeragamkan tile layer Leaflet OpenStreetMap di semua role (Admin, Operator, Mitra, Supir, Pasien), mengaktifkan zoom mouse wheel di Admin, dan memperbaiki akurasi warna pin marker status armada.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot tampilan peta seragam di Admin, Operator, & Pasien</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Peta seragam, zoom interaktif, & pin 3D rapi)</Data></Cell>
   </Row>
   <Row ss:Height="48">
    <Cell ss:StyleID="CellNo"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Pengujian Alur End-to-End Pemesanan & Navigasi Ambulans</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Melakukan testing terpadu mulai dari pasien membuat pesanan darurat, notifikasi operator, assign supir, navigasi supir ke lokasi, hingga update status selesai.</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Screenshot alur status perjalanan ambulans dari order hingga selesai</Data></Cell>
    <Cell ss:StyleID="CellStatus"><Data ss:Type="String">Selesai (Alur end-to-end terverifikasi)</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
</Workbook>